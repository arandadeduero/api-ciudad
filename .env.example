# ─── Core (Fase 1 — requeridas, la app falla al arrancar si faltan) ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS: lista separada por comas de orígenes permitidos, o "*" para acceso público sin restricción.
# Ver docs/architecture-proposal.md §6 — pendiente de decisión para producción.
CORS_ORIGIN=*

# Rate limiting global (por IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Cache: "memory" (por defecto) o "redis"
CACHE_DRIVER=memory
# Requerido solo si CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# ─── Fuentes externas (se activan en fases 2-6, ver docs/architecture-proposal.md) ───
# Ninguna de estas es requerida todavía por el código de la Fase 1.

# Open-Meteo no requiere API key (uso no comercial, 10.000 llamadas/día)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# AEMET OpenData — API key gratuita por email en https://opendata.aemet.es
# IMPORTANTE: desde el 15-oct-2026 las keys sin fecha de expiración dejan de ser válidas.
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api

# JCyL — API Opendatasoft Explore v2.1, sin autenticación
JCYL_OPENDATA_BASE_URL=https://analisis.datosabiertos.jcyl.es/api/explore/v2.1

# GTFS — rutas a los ficheros (aportados por el usuario, ver docs/architecture-proposal.md §6.2)
GTFS_INTERURBANO_PATH=
GTFS_URBANO_PATH=

# Waze for Cities — pendiente de alta institucional por el Ayuntamiento (ver docs/architecture-proposal.md §6.4)
WAZE_ENABLED=false
WAZE_FEED_URL=

# Río / CHD-SAIH — pendiente de fuente real (ver docs/architecture-proposal.md §6.3)
RIVER_API_BASE_URL=

# Matomo — opcional, la app funciona igual si está desactivado o caído
MATOMO_ENABLED=false
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_TOKEN=
