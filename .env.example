# ─── Core (Fase 1 — requeridas, la app falla al arrancar si faltan) ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS: lista separada por comas de orígenes permitidos, o "*" para acceso público sin restricción.
# Decisión confirmada (2026-09-09, ver docs/architecture-proposal.md §6): API de
# datos abiertos de acceso público, sin restricción de origen. "*" es el valor
# de producción, no solo el de desarrollo.
CORS_ORIGIN=*

# Rate limiting global (por IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Cache: "memory" (por defecto) o "redis"
CACHE_DRIVER=memory
# Requerido solo si CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# ─── Fuentes externas ───

# Open-Meteo no requiere API key (uso no comercial, 10.000 llamadas/día). Fase 2.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_MS=5000
WEATHER_CACHE_TTL_SECONDS=600
# Coordenadas por defecto: Plaza Mayor de Aranda de Duero
ARANDA_LATITUDE=41.6701895
ARANDA_LONGITUDE=-3.6885626

# AEMET OpenData — API key gratuita por email en https://opendata.aemet.es.
# Usada por GET /api/v1/weather/avisos (Fase 7). Sin key, ese endpoint
# devuelve AVISOS_NOT_CONFIGURED — el resto de la API funciona igual.
# IMPORTANTE: desde el 15-oct-2026 las keys sin fecha de expiración dejan de ser válidas.
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata/api
AEMET_TIMEOUT_MS=10000
# 67 = Castilla y León (tabla de códigos del propio spec de AEMET).
AEMET_AVISOS_AREA=67
# 670904 = "Meseta de Burgos" — determinado por point-in-polygon contra el
# CAP-XML real de AEMET con las coordenadas de Aranda de Duero (2026-09-09),
# no asumido de una tabla de referencia.
AEMET_AVISOS_ZONA_CODIGO=670904
AEMET_AVISOS_ZONA_NOMBRE=Meseta de Burgos
AEMET_AVISOS_CACHE_TTL_SECONDS=900

# JCyL — API Opendatasoft Explore v2.1, sin autenticación. Fase 3 (ambiente) y
# Fase 7 (educación, bibliotecas) comparten el mismo proveedor.
# Dos datasets distintos para ambiente (ver docs/API-REFERENCE.md — sección
# Ambiente): el del día en curso (horario, casi tiempo real) y el histórico
# diario (agregado, con retraso de publicación de varios meses).
# Estación real de Aranda de Duero (docs/architecture-proposal.md §2.2 —
# corrige un error de la investigación inicial: sí hay estación en el municipio).
JCYL_OPENDATA_BASE_URL=https://analisis.datosabiertos.jcyl.es/api/explore/v2.1
JCYL_TIMEOUT_MS=5000
JCYL_AIR_QUALITY_DATASET_TODAY=calidad-del-aire-del-dia-en-curso
JCYL_AIR_QUALITY_DATASET_HISTORICAL=calidad-del-aire-datos-historicos-diarios
JCYL_AIR_QUALITY_STATION=Aranda de Duero 2
JCYL_AIR_QUALITY_STATION_ID=82
JCYL_AIR_QUALITY_PROVINCE=Burgos
AMBIENTE_CACHE_TTL_SECONDS=600

# Educación (Fase 7) — directorio de centros docentes de JCyL, 27 centros
# reales confirmados en Aranda de Duero (2026-09-09). El campo "municipio"
# de este dataset concreto va en mayúsculas.
EDUCACION_DATASET=directorio-de-centros-docentes
EDUCACION_MUNICIPIO=ARANDA DE DUERO
EDUCACION_CACHE_TTL_SECONDS=86400

# Bibliotecas (Fase 7) — mismo proveedor JCyL. El campo "localidad" de este
# dataset concreto va en formato mixto, no en mayúsculas.
BIBLIOTECAS_DATASET=bibliotecas-bibliobuses-y-puntos-de-servicio-movil-geolocalizados
BIBLIOTECAS_LOCALIDAD=Aranda de Duero
BIBLIOTECAS_CACHE_TTL_SECONDS=86400

# GTFS urbano (L1/L2/L3) — feed real, releases automáticas vía GitHub Actions.
# Fase 4. Ver docs/architecture-proposal.md §2.1b. Licencia AGPL-3.0 declarada
# en el repo — pendiente confirmar alcance con el mantenedor antes de producción.
# GTFS_URBANO_CACHE_DIR es la caché en disco del feed descargado (resiliencia:
# si GitHub Releases falla, se sirve la última copia conocida desde aquí).
GTFS_URBANO_REPO=arandadeduero/gtfs-busurbano
GTFS_URBANO_CACHE_DIR=./data/gtfs-urbano
GTFS_TIMEOUT_MS=10000

# GTFS interurbano Madrid-Aranda-Burgo de Osma (AISA) — NAP estatal, fuente
# secundaria, no consumida todavía por el código.
GTFS_INTERURBANO_PATH=

# Waze for Cities — NO DISPONIBLE POR AHORA (decisión del usuario, 2026-09-09).
# Requiere alta institucional del Ayuntamiento, sin trámite en curso. El
# módulo de cortes de calles queda fuera de la v1 (ver docs/architecture-proposal.md §6).
# No consumida por el código — documentada solo para dejar constancia de la decisión.
WAZE_ENABLED=false
WAZE_FEED_URL=

# Río — API real aportada por el usuario (2026-09-09, ver docs/architecture-proposal.md §2.2b).
# Servicio de terceros que envuelve datos SAIH-CHD, no es la API oficial de
# la Confederación Hidrográfica del Duero. Fase 5.
RIVER_API_BASE_URL=https://chd-api.arandadeduero.dev
RIVER_STATION_CODE=EA013
RIVER_TIMEOUT_MS=8000
RIVER_CACHE_TTL_SECONDS=600

# Embalse (Fase 7) — extensión de /rio. EM511 = Embalse de Linares del
# Arroyo (Maderuelo, Segovia — cuenca del Duero, no en el municipio de
# Aranda). Sin API JSON: se extrae de la ficha HTML pública del SAIH del
# Duero, la única fuente que publica el % de volumen embalsado.
SAIH_DUERO_BASE_URL=https://www.saihduero.es
EMBALSE_STATION_CODE=EM511
EMBALSE_TIMEOUT_MS=8000
EMBALSE_CACHE_TTL_SECONDS=600

# Matomo — opcional, la app funciona igual si está desactivado o caído. Fase 6.
MATOMO_ENABLED=false
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_TOKEN=
