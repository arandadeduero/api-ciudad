{
  "name": "api-ciudad",
  "version": "0.1.0",
  "description": "API Ciudad de Aranda de Duero — capa de agregación de datos abiertos municipales, regionales y estatales",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/.bin/vitest run",
    "test:watch": "node --env-file-if-exists=.env node_modules/.bin/vitest",
    "test:e2e": "node --env-file-if-exists=.env node_modules/.bin/vitest run test/e2e",
    "test:coverage": "node --env-file-if-exists=.env node_modules/.bin/vitest run --coverage",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@scalar/fastify-api-reference": "1.69.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "node-html-parser": "^9.0.4",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
